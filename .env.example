# ---------------------------------------------------------------------------
# CardLens environment. Copy to `.env` for local dev. NEVER commit real secrets.
# Frontend vars are prefixed VITE_ and are PUBLIC (compiled into the bundle).
# Anything secret (API keys) lives ONLY in the server-side vars below.
# ---------------------------------------------------------------------------

# --- Frontend (public, safe to expose) -------------------------------------

# Where the catalog/pricing provider fetches from.
#   Direct (default, works keyless, open CORS):  https://api.pokemontcg.io/v2
#   Via our proxy (adds server-side key + cache): /api/catalog
VITE_API_BASE_URL=https://api.pokemontcg.io/v2

# Base URL of the companion-phone relay endpoints. Same-origin `/api` by default
# (Vite proxies /api -> the server in dev; in prod point it at your server host).
VITE_COMPANION_API_BASE_URL=/api

# Force mock data (no network). Enabled automatically under tests.
VITE_USE_MOCKS=false

# Show the developer panel (simulated input, network toggles). Off in production.
VITE_ENABLE_DEV_PANEL=true

# --- Server ( server/ , private ) ------------------------------------------

# Port the Express relay/proxy listens on.
PORT=8787

# OPTIONAL server-side pokemontcg.io key. Lifts limits to 20k/day. Keeps the key
# OUT of the browser — the frontend calls /api/catalog, the server adds this header.
# Leave blank to run keyless (1000/day).
POKEMONTCG_API_KEY=

# Comma-separated allowed origins for CORS on the server (companion + proxy).
# Use your deployed frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:5173

# Companion session time-to-live in seconds (short-lived by design).
COMPANION_SESSION_TTL_SECONDS=300
