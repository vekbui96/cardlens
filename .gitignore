# dependencies
node_modules

# build output
dist
dist-ssr
*.local

# test / tooling output
coverage
playwright-report
test-results
.playwright
node_modules/.tmp
*.tsbuildinfo

# env — never commit secrets
.env
.env.*
!.env.example

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# Agent worktrees: full checkouts of this repo (2.4GB, each with its own
# node_modules) living inside it. They are already excluded from eslint and
# prettier; without this, `git add -A .claude` commits twelve gitlinks and a
# worktree's screenshots, which is exactly what happened once.
.claude/worktrees/
